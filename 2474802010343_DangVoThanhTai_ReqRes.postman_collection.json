    {
      "name": "Positive_Cases (Happy Path)",
      "item": [
        {
          "name": "Register User - Get Auth Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response has token\", function () {\r\n    const jsonData = pm.response.json();\r\n    pm.expect(jsonData.token).to.be.a(\"string\");\r\n    pm.expect(jsonData.token).to.not.be.empty;\r\n});\r\n\r\nif (pm.response.code === 200 && pm.response.json().token) {\r\n    pm.environment.set(\"userToken\", pm.response.json().token);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n \"email\": \"eve.holt@reqres.in\",\r\n \"password\": \"pistol\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create User - Data Driven Testing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst jsonData = pm.response.json();\r\nconst expectedName = pm.iterationData.get(\"name\");\r\nconst expectedJob = pm.iterationData.get(\"job\");\r\n\r\npm.test(\"Name matches CSV\", function () {\r\n    pm.expect(jsonData.name).to.eql(expectedName);\r\n});\r\n\r\npm.test(\"Job matches CSV\", function () {\r\n    pm.expect(jsonData.job).to.eql(expectedJob);\r\n});\r\n\r\npm.test(\"Response has user ID\", function () {\r\n    pm.expect(jsonData.id).to.exist;\r\n});\r\n\r\nif (pm.response.code === 201 && jsonData.id !== undefined) {\r\n    pm.environment.set(\"userId\", String(jsonData.id));\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"job\": \"{{job}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Single User",
